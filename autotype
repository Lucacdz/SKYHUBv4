local CONFIG_FILE = "SkyHubPro.json"
local CanSave = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
local lastSaved = ""

local function EncodeConfig()
    local data = {}
    for k, v in pairs(S) do
        if typeof(v) == "boolean" or typeof(v) == "number" or typeof(v) == "string" then data[k] = v end
    end
    data.Aim = false data.Spin = false data.Noclip = false data.FakeLag = false
    return HttpService:JSONEncode(data)
end

local function SaveConfig()
    if not CanSave then return false, "Không hỗ trợ lưu file" end
    local ok = pcall(function() writefile(CONFIG_FILE, EncodeConfig()) lastSaved = EncodeConfig() end)
    return ok, ok and "Đã lưu" or "Lỗi lưu"
end

local function LoadConfig()
    if not CanSave then return false end
    local ok = pcall(function()
        if not isfile(CONFIG_FILE) then error() end
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        for k, v in pairs(data) do if S[k] \~= nil and typeof(S[k]) == typeof(v) then S[k] = v end end
    end)
    if ok then
        S.CircleIdx = math.clamp(S.CircleIdx or 1, 1, #PaletteColors)
        S.ESPIdx = math.clamp(S.ESPIdx or 4, 1, #PaletteColors)
        S.AuraIdx = math.clamp(S.AuraIdx or 6, 1, #PaletteColors)
        S.CircleColor = PaletteColors[S.CircleIdx]
        S.ESPColor = PaletteColors[S.ESPIdx]
        S.AuraColor = PaletteColors[S.AuraIdx]
        S.Aim = false S.Spin = false S.Noclip = false S.FakeLag = false
    end
    return ok
end
LoadConfig()

local function New(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
