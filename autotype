-- ========== LOGIC ==========
local isVisible = true
local currentWords = {nil, nil}
local lastDetected = ""

local function getTwoWords(prefix)
	prefix = string.upper(tostring(prefix or ""))
	if #prefix == 0 then return nil, nil end

	local matches = {}
	for _, word in ipairs(wordList) do
		if string.sub(string.upper(word), 1, #prefix) == prefix then
			table.insert(matches, word)
		end
	end

	if #matches == 0 then return nil, nil end

	for i = #matches, 2, -1 do
		local j = math.random(1, i)
		matches[i], matches[j] = matches[j], matches[i]
	end

	return matches[1], matches[2] or matches[1]
end

local function autoFill(word)
	if not word or word == "" then return end

	-- Điền vào helper
	inputBox.Text = word

	-- Tìm TextBox đang focus trong game
	local focused = UserInputService:GetFocusedTextBox()
	if focused and focused:IsA("TextBox") and focused ~= inputBox then
		focused.Text = word
		focused:CaptureFocus()
	end
end

local function updateSuggestions(prefix)
	prefix = string.upper(tostring(prefix or ""))
	prefix = string.sub(prefix, 1, 2)

	if prefix == "" then
		wordBtn1.Text = "Chưa có chữ cái"
		wordBtn2.Text = ""
		currentWords = {nil, nil}
		return
	end

	local w1, w2 = getTwoWords(prefix)
	currentWords = {w1, w2}

	if w1 then
		wordBtn1.Text = w1
		wordBtn2.Text = w2 or ""
	else
		wordBtn1.Text = "Không tìm thấy"
		wordBtn2.Text = ""
		currentWords = {nil, nil}
	end
end

-- ========== TỰ PHÁT HIỆN CHỮ CÁI ==========
local function detectPrefix()
	local found = ""

	-- Quét toàn bộ PlayerGui tìm TextLabel có chứa chữ cái ngắn
	for _, gui in ipairs(PlayerGui:GetDescendants()) do
		if gui:IsA("TextLabel") or gui:IsA("TextButton") then
			local text = string.upper(gui.Text or "")

			-- Tìm pattern kiểu "BẰNG A", "BẰNG AB", "STARTING WITH A"...
			local match = string.match(text, "BẮT ĐẦU BẰNG%s*([A-Z]{1,2})") 
				or string.match(text, "BẰNG%s*([A-Z]{1,2})")
				or string.match(text, "STARTING WITH%s*([A-Z]{1,2})")
				or string.match(text, "STARTS WITH%s*([A-Z]{1,2})")

			if match and #match <= 2 then
				found = match
				break
			end

			-- Nếu text rất ngắn (1-2 chữ cái) và nằm gần giữa màn hình
			if #text >= 1 and #text <= 2 and text:match("^[A-Z]+$") then
				local pos = gui.AbsolutePosition
				local size = gui.AbsoluteSize
				if pos.Y > 50 and pos.Y < 400 and size.X > 20 then
					found = text
					break
				end
			end
		end
	end

	if found ~= "" and found ~= lastDetected then
		lastDetected = found
		detectLabel.Text = "Phát hiện: " .. found
		inputBox.Text = found
		updateSuggestions(found)
	elseif found == "" then
		detectLabel.Text = "Chưa phát hiện chữ cái"
	end
end

