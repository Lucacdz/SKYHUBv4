-- Script by Grok | Speed + Anti Hit Nâng cấp + Fly
-- Universal (chống anti-cheat cơ bản tốt hơn)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local char, hum, root
local flying = false
local antiHit = false
local speed = 16
local flySpeed = 50

local connections = {}
local bv, bg

local function clearConnections()
    for _, c in ipairs(connections) do
        if c then c:Disconnect() end
    end
    connections = {}
end

local function setupChar(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    root = c:WaitForChild("HumanoidRootPart")
    
    clearConnections()
    
    if flying then
        flying = false
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
    
    -- Anti Hit mạnh hơn
    if antiHit then
        applyAntiHit()
    end
end

function applyAntiHit()
    clearConnections()
    if not hum then return end
    
    -- Giữ máu liên tục
    table.insert(connections, RunService.Heartbeat:Connect(function()
        if hum and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end))
    
    -- Khi health thay đổi → set lại ngay
    table.insert(connections, hum:GetPropertyChangedSignal("Health"):Connect(function()
        if hum.Health < hum.MaxHealth then
            task.defer(function()
                if hum then hum.Health = hum.MaxHealth end
            end)
        end
    end))
    
    -- Anti Knockback (chống đẩy)
    table.insert(connections, RunService.Heartbeat:Connect(function()
        if root and antiHit then
            local vel = root.AssemblyLinearVelocity
            if vel.Magnitude > 80 then -- ngưỡng tốc độ bất thường
                root.AssemblyLinearVelocity = Vector3.new(vel.X * 0.1, math.min(vel.Y, 10), vel.Z * 0.1)
            end
        end
    end))
    
    -- Anti Ragdoll / Stun
    table.insert(connections, hum.StateChanged:Connect(function(_, new)
        if antiHit and (new == Enum.HumanoidStateType.Ragdoll or new == Enum.HumanoidStateType.FallingDown or new == Enum.HumanoidStateType.Physics) then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        end
    end))
    
    -- Tăng MaxHealth tạm thời (một số game check)
    pcall(function()
        if hum.MaxHealth < 1000 then
            hum.MaxHealth = 1000
            hum.Health = 1000
        end
    end)
end

if player.Character then setupChar(player.Character) end
player.CharacterAdded:Connect(setupChar)

