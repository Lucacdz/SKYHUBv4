-- ===== LOGIC =====
local function GetCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function IsInFOV(part)
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return false end
    return (Vector2.new(pos.X, pos.Y) - GetCenter()).Magnitude <= FOVRadius
end

local function GetTarget()
    local nearest, shortest = nil, math.huge
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 and IsInFOV(head) then
                local dist = (myRoot.Position - head.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = head
                end
            end
        end
    end
    return nearest
end

local function RemoveESP(plr)
    local o = ESPObjects[plr]
    if o then
        pcall(function() o.Tracer:Remove() end)
        pcall(function() o.Box:Remove() end)
        pcall(function() o.Text:Remove() end)
        ESPObjects[plr] = nil
    end
end

local function HideESP(o)
    o.Tracer.Visible = false
    o.Box.Visible = false
    o.Text.Visible = false
end

Players.PlayerRemoving:Connect(RemoveESP)

local lockedTarget = nil

RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    local center = GetCenter()
    FOVCircle.Position = center
    FOVCircle.Radius = FOVRadius
    FOVCircle.Color = CircleColor
    FOVCircle.Visible = AimEnabled

    -- AIM
    if AimEnabled then
        -- tắt khi mục tiêu đang khóa chết
        if AutoOffOnDeath and lockedTarget then
            local hum = lockedTarget.Parent and lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then
                lockedTarget = nil
                SetAim(false)
            end
        end
        if AimEnabled then
            local target = GetTarget()
            lockedTarget = target
            if target then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            end
        end
    else
        lockedTarget = nil
    end

    -- ESP
    if not ESPEnabled then
        for plr in pairs(ESPObjects) do
            RemoveESP(plr)
        end
        return
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local seen = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if head and root and hum and hum.Health > 0 then
                seen[player] = true

                if not ESPObjects[player] then
                    local o = {
                        Tracer = NewDrawing("Line"),
                        Box = NewDrawing("Square"),
                        Text = NewDrawing("Text"),
                    }
                    o.Tracer.Thickness = 1.5
                    o.Box.Thickness = 1.5
                    o.Box.Filled = false
                    o.Text.Size = 13
                    o.Text.Center = true
                    o.Text.Outline = true
                    ESPObjects[player] = o
                end

                local o = ESPObjects[player]
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)

                if onScreen then
                    o.Tracer.Visible = ShowTracer
                    o.Box.Visible = ShowBox
                    o.Text.Visible = ShowDistance

                    if ShowTracer then
                        o.Tracer.From = Vector2.new(center.X, 0)
                        o.Tracer.To = Vector2.new(pos.X, pos.Y)
                        o.Tracer.Color = TracerColor
                    end
                    if ShowBox then
                        local rootPos = Camera:WorldToViewportPoint(root.Position)
                        local sz = (Vector2.new(rootPos.X, rootPos.Y) - Vector2.new(pos.X, pos.Y)).Magnitude * 2
                        o.Box.Size = Vector2.new(sz * 0.65, sz)
                        o.Box.Position = Vector2.new(pos.X - sz * 0.32, pos.Y - sz * 0.45)
                        o.Box.Color = ESPColor
                    end
                    if ShowDistance then
                        local d = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                        o.Text.Text = player.Name .. " [" .. d .. "]"
                        o.Text.Position = Vector2.new(pos.X, pos.Y - 28)
                        o.Text.Color = ESPColor
                    end
                else
                    HideESP(o)
                end
            end
        end
    end

    for plr in pairs(ESPObjects) do
        if not seen[plr] then
            RemoveESP(plr)
        end
    end
end)

