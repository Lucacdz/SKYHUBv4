-- Kéo GUI (chuột + cảm ứng)
do
    local dragging, dragStart, startPos
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local isOpen = true
local busy = false
local function ToggleGUI()
    if busy then return end
    busy = true
    isOpen = not isOpen
    if isOpen then
        MiniBox.Visible = false
        MainFrame.Position = MiniBox.Position
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Visible = true
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Size = UDim2.new(0, 280, 0, 300)})
        t:Play()
        t.Completed:Connect(function() busy = false end)
    else
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 0, 0, 0)})
        t:Play()
        t.Completed:Connect(function()
            MainFrame.Visible = false
            MiniBox.Position = MainFrame.Position
            MiniBox.Visible = true
            busy = false
        end)
    end
end
CloseBtn.MouseButton1Click:Connect(ToggleGUI)
MiniBox.MouseButton1Click:Connect(ToggleGUI)

