local function TrySpoofText(text, realName, display)
    if not text or text == "" then return text end
    local n = text
    if realName and #realName > 0 and n:find(realName, 1, true) then
        n = n:gsub(realName, "Lucacdz")
    end
    if display and #display > 0 and display ~= realName and n:find(display, 1, true) then
        n = n:gsub(display, "Lucacdz")
    end
    return n
end

local function ScanAndSpoof(obj, realName, display, depth)
    if depth > 8 or not obj then return end
    local ok, class = pcall(function() return obj.ClassName end)
    if not ok then return end

    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        pcall(function()
            local t = obj.Text
            if t and t ~= "" then
                local nt = TrySpoofText(t, realName, display)
                if nt ~= t then obj.Text = nt end
            end
            if class == "TextBox" then
                local ph = obj.PlaceholderText
                if ph and ph ~= "" then
                    local nph = TrySpoofText(ph, realName, display)
                    if nph ~= ph then obj.PlaceholderText = nph end
                end
            end
        end)
    end

    local ok2, children = pcall(function() return obj:GetChildren() end)
    if ok2 then
        for _, c in ipairs(children) do
            pcall(ScanAndSpoof, c, realName, display, depth + 1)
        end
    end
end

local function SpoofNames()
    if not S.HideName then return end
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, {n = p.Name, d = p.DisplayName})
        end
    end
    if #list == 0 then return end

    local function scanGuiAll(gui)
        if not gui then return end
        for _, info in ipairs(list) do
            pcall(ScanAndSpoof, gui, info.n, info.d, 0)
        end
    end

    pcall(function() scanGuiAll(LocalPlayer.PlayerGui) end)

    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            local pg = plr:FindFirstChildOfClass("PlayerGui")
            if pg and pg ~= LocalPlayer.PlayerGui then
                scanGuiAll(pg)
            end
        end
    end)

    pcall(function() scanGuiAll(game:GetService("CoreGui")) end)

    pcall(function()
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:FindFirstChildOfClass("Humanoid") then
                local p = Players:GetPlayerFromCharacter(obj)
                if p and p ~= LocalPlayer then
                    local head = obj:FindFirstChild("Head")
                    if head then
                        for _, child in ipairs(head:GetChildren()) do
                            if child:IsA("BillboardGui") and child.Name ~= "SkyTag" then
                                pcall(ScanAndSpoof, child, p.Name, p.DisplayName, 0)
                            end
                        end
                    end
                end
            end
        end
    end)

    pcall(function()
        local tcs = game:GetService("TextChatService")
        for _, ch in ipairs(tcs:GetDescendants()) do
            if ch:IsA("TextLabel") or ch:IsA("TextButton") then
                scanGuiAll(ch)
            end
        end
    end)
end

