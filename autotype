-- ===== ESP =====
local function ClearESP(char)
    if not char then return end
    local h = char:FindFirstChild("SkyESP")
    if h then h:Destroy() end
    local head = char:FindFirstChild("Head")
    if head then
        local t = head:FindFirstChild("SkyTag")
        if t then t:Destroy() end
    end
end

local function ApplyESP(p)
    local char = p.Character
    if not S.ESP or not char or not IsAlive(char) or (S.ESPTeam and IsTeammate(p)) then
        ClearESP(char)
        return
    end

    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not root or not hum then return end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local origin = myRoot and myRoot.Position or Camera.CFrame.Position
    local d = (origin - root.Position).Magnitude
    if d > S.ESPDist then
        ClearESP(char)
        return
    end

    local color = S.ESPColor
    if S.ESPTeamColor and p.Team then color = p.TeamColor.Color end

    local hl = char:FindFirstChild("SkyESP")
    if S.Chams then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "SkyESP"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.OutlineTransparency = 0
            hl.Parent = char
        end
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = S.ChamsFill
    elseif hl then
        hl:Destroy()
    end

    local tag = head:FindFirstChild("SkyTag")
    if S.ShowName or S.ShowDist or S.ShowHP then
        local lines = {}
        if S.ShowName then table.insert(lines, p.Name) end
        local info = {}
        if S.ShowDist then table.insert(info, math.floor(d) .. "m") end
        if S.ShowHP then table.insert(info, "HP " .. math.floor(hum.Health)) end
        if #info > 0 then table.insert(lines, table.concat(info, " | ")) end

        if not tag then
            tag = New("BillboardGui", {
                Name = "SkyTag",
                StudsOffset = Vector3.new(0, 2.8, 0),
                AlwaysOnTop = true,
                Adornee = head,
            })
            New("TextLabel", {
                Name = "Lbl",
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextStrokeTransparency = 0,
            }, tag)
            tag.Parent = head
        end
        tag.Size = UDim2.new(0, 190, 0, math.max(#lines, 1) * (S.TextSize + 4))
        local lbl = tag:FindFirstChild("Lbl")
        if lbl then
            lbl.Text = table.concat(lines, "\n")
            lbl.TextSize = S.TextSize
            lbl.TextColor3 = color
        end
    elseif tag then
        tag:Destroy()
    end
end

task.spawn(function()
    while Gui.Parent do
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                pcall(ApplyESP, p)
            end
        end
        task.wait(0.2)
    end
    for _, p in ipairs(Players:GetPlayers()) do
        pcall(ClearESP, p.Character)
    end
end)

