local orderCounter = 0
local function NextOrder()
    orderCounter = orderCounter + 1
    return orderCounter
end

local TextRegistry = {}
local function RegText(obj, key)
    if obj and key then
        table.insert(TextRegistry, {obj = obj, key = key})
    end
end

local function Section(page, text, textKey)
    local lbl = New("TextLabel", {
        Size = UDim2.new(1,0,0,20), BackgroundTransparency = 1,
        Text = text, TextColor3 = T.Sub, Font = Enum.Font.GothamBold,
        TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = NextOrder(),
    }, page)
    if textKey then RegText(lbl, textKey) end
    return lbl
end

local function ItemFrame(page, height)
    local f = New("Frame", {
        Size = UDim2.new(1,0,0,height),
        BackgroundColor3 = T.Item, BorderSizePixel = 0,
        LayoutOrder = NextOrder(),
    }, page)
    Round(f, 8)
    return f
end

local function ItemLabel(parent, text, y, textKey)
    local lbl = New("TextLabel", {
        Size = UDim2.new(0.65,0,0,22), Position = UDim2.new(0,10,0,y or 0),
        BackgroundTransparency = 1, Text = text, TextColor3 = T.Text,
        Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    if textKey then RegText(lbl, textKey) end
    return lbl
end

local function Toggle(page, text, def, cb, textKey)
    local f = ItemFrame(page, 36)
    local lbl = New("TextLabel", {
        Size = UDim2.new(1,-70,1,0), Position = UDim2.new(0,10,0,0),
        BackgroundTransparency = 1, Text = text, TextColor3 = T.Text,
        Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, f)
    if textKey then RegText(lbl, textKey) end

    local sw = New("Frame", {
        Size = UDim2.new(0,40,0,20), Position = UDim2.new(1,-50,0.5,-10),
        BackgroundColor3 = T.Off, BorderSizePixel = 0,
    }, f)
    Round(sw, 10)
    local knob = New("Frame", {
        Size = UDim2.new(0,16,0,16), BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
    }, sw)
    Round(knob, 8)

    local state = def
    local function render()
        sw.BackgroundColor3 = state and T.Accent or T.Off
        knob.Position = state and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
    end

    local hit = New("TextButton", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = ""}, f)
    hit.MouseButton1Click:Connect(function()
        state = not state
        render()
        cb(state)
    end)

    render()
    cb(state)

    return function(v)
        state = v
        render()
        cb(v)
    end
end

local function Slider(page, text, min, max, def, step, fmt, cb, textKey)
    local f = ItemFrame(page, 50)
    ItemLabel(f, text, 4, textKey)
    local val = New("TextLabel", {
        Size = UDim2.new(0.35,0,0,22), Position = UDim2.new(0.65,-10,0,4),
        BackgroundTransparency = 1, Text = "", TextColor3 = T.Accent,
        Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, f)

    local track = New("Frame", {
        Size = UDim2.new(1,-20,0,6), Position = UDim2.new(0,10,0,34),
        BackgroundColor3 = T.Off, BorderSizePixel = 0,
    }, f)
    Round(track, 3)
    local fill = New("Frame", {Size = UDim2.new(0,0,1,0), BackgroundColor3 = T.Accent, BorderSizePixel = 0}, track)
    Round(fill, 3)
    local knob = New("Frame", {
        Size = UDim2.new(0,16,0,16), AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(0,0,0.5,0), BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
    }, track)
    Round(knob, 8)

    local function set(v)
        local a = (v - min) / (max - min)
        fill.Size = UDim2.new(a,0,1,0)
        knob.Position = UDim2.new(a,0,0.5,0)
        val.Text = fmt and fmt(v) or tostring(v)
        cb(v)
    end

    local function setFromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local v = min + a * (max - min)
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, min, max)
        set(v)
    end

    local hit = New("TextButton", {
        Size = UDim2.new(1,0,0,30), Position = UDim2.new(0,0,0,20),
        BackgroundTransparency = 1, Text = "",
    }, f)

    local dragging = false
    hit.InputBegan:Connect(function(input)
        if IsPress(input) then
            dragging = true
            SetScroll(false)
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and IsMove(input) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and IsPress(input) then
            dragging = false
            SetScroll(true)
        end
    end)

    set(def)
end

local function Palette(page, text, defIdx, cb, textKey)
    local f = ItemFrame(page, 62)
    ItemLabel(f, text, 4, textKey)
    local strokes = {}
    local function render(idx)
        for i, st in ipairs(strokes) do st.Enabled = (i == idx) end
    end
    for i, c in ipairs(PaletteColors) do
        local b = New("TextButton", {
            Size = UDim2.new(0,28,0,22),
            Position = UDim2.new(0, 10 + (i-1)*36, 0, 32),
            BackgroundColor3 = c, BorderSizePixel = 0,
            Text = "", AutoButtonColor = false,
        }, f)
        Round(b, 6)
        strokes[i] = New("UIStroke", {Thickness = 2, Color = Color3.new(1,1,1), Enabled = false}, b)
        b.MouseButton1Click:Connect(function()
            render(i)
            cb(c, i)
        end)
    end
    render(defIdx)
    cb(PaletteColors[defIdx], defIdx)
end

local function Choice(page, text, opts, defIdx, cb, textKey)
    local f = ItemFrame(page, 62)
    ItemLabel(f, text, 4, textKey)
    local buttons = {}
    local n = #opts
    local function render(idx)
        for i, b in ipairs(buttons) do
            b.BackgroundColor3 = (i == idx) and T.Accent or T.Off
        end
    end
    for i, opt in ipairs(opts) do
        local label = opt.key and Txt(opt.key) or (opt.label or "")
        local b = New("TextButton", {
            Size = UDim2.new(1/n,-8,0,26),
            Position = UDim2.new((i-1)/n, 6, 0, 30),
            BackgroundColor3 = T.Off, BorderSizePixel = 0,
            Text = label, TextColor3 = T.Text,
            Font = Enum.Font.Gotham, TextSize = 13,
            AutoButtonColor = false,
        }, f)
        Round(b, 6)
        if opt.key then RegText(b, opt.key) end
        buttons[i] = b
        b.MouseButton1Click:Connect(function()
            render(i)
            cb(i, opt.key)
        end)
    end
    render(defIdx)
    cb(defIdx, opts[defIdx].key)
end

local function Button(page, text, color, cb, textKey)
    local b = New("TextButton", {
        Size = UDim2.new(1,0,0,36),
        BackgroundColor3 = color or T.Accent,
        BorderSizePixel = 0, Text = text,
        TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamBold, TextSize = 13,
        LayoutOrder = NextOrder(),
    }, page)
    Round(b, 8)
    if textKey then RegText(b, textKey) end
    b.MouseButton1Click:Connect(function() cb(b) end)
    return b
end

