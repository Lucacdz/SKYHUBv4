-- Button function (fixed click)
local function createButton(text, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 38)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 100)
    btn.Text = text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.AutoButtonColor = true
    btn.Active = true
    btn.ZIndex = 5
    btn.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    return btn
end

local flyBtn = createButton("Fly: OFF", 185)
local antiBtn = createButton("Anti Hit+: OFF", 235)

-- Fly Button
flyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    flyBtn.Text = flying and "Fly: ON" or "Fly: OFF"
    flyBtn.BackgroundColor3 = flying and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(70, 70, 100)

    if flying then
        if root then
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = root

            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 10000
            bg.Parent = root
        end
    else
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        if hum then hum.WalkSpeed = speed end
    end
end)

-- Anti Hit Button
antiBtn.MouseButton1Click:Connect(function()
    antiHit = not antiHit
    antiBtn.Text = antiHit and "Anti Hit+: ON" or "Anti Hit+: OFF"
    antiBtn.BackgroundColor3 = antiHit and Color3.fromRGB(180, 50, 50) or Color3.fromRGB(70, 70, 100)

    if antiHit then
        applyAntiHit()
    else
        clearConnections()
        pcall(function()
            if hum then
                hum.MaxHealth = 100
                hum.Health = 100
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            end
        end)
    end
end)

-- Main loop
RunService.Heartbeat:Connect(function()
    if not char or not hum or not root then return end

    if not flying then
        hum.WalkSpeed = speed
    end

    if flying and bv and bg then
        local moveDir = Vector3.zero
        local camCF = camera.CFrame

        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDir -= Vector3.new(0, 1, 0)
        end

        if UIS.TouchEnabled and hum.MoveDirection.Magnitude > 0.1 then
            moveDir = hum.MoveDirection
        end

        if moveDir.Magnitude > 0 then
            bv.Velocity = moveDir.Unit * flySpeed
        else
            bv.Velocity = Vector3.zero
        end

        bg.CFrame = camCF
    end
end)

