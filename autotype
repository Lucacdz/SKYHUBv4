-- Logic
local currentWords = {nil, nil}
local lastPrefix = ""

local function getTwoWords(prefix)
	prefix = string.upper(tostring(prefix or "")):gsub("%s+", "")
	if #prefix == 0 or #prefix > 2 then return nil, nil end

	local matches = {}
	for _, word in ipairs(wordList) do
		if string.sub(string.upper(word), 1, #prefix) == prefix then
			table.insert(matches, word)
		end
	end
	if #matches == 0 then return nil, nil end

	for i = #matches, 2, -1 do
		local j = math.random(1, i)
		matches[i], matches[j] = matches[j], matches[i]
	end
	return matches[1], matches[2] or matches[1]
end

local function updateUI(prefix)
	prefix = string.upper(tostring(prefix or "")):sub(1, 2)
	local w1, w2 = getTwoWords(prefix)
	currentWords = {w1, w2}

	if w1 then
		wordBtn1.Text = w1
		wordBtn2.Text = w2 or ""
		detectLabel.Text = "Phát hiện: " .. prefix
	else
		wordBtn1.Text = "Không có từ"
		wordBtn2.Text = ""
		detectLabel.Text = "Chưa tìm thấy chữ cái"
	end
end

local function autoFill(word)
	if not word then return end
	inputBox.Text = word

	local focused = UserInputService:GetFocusedTextBox()
	if focused and focused ~= inputBox then
		focused.Text = word
	end
end

-- Tự phát hiện
task.spawn(function()
	while screenGui.Parent do
		local found = ""

		for _, obj in ipairs(PlayerGui:GetDescendants()) do
			if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text then
				local txt = string.upper(obj.Text)

				-- Tìm pattern tiếng Việt
				local m = txt:match("BẮT ĐẦU BẰNG%s*([A-Z]{1,2})")
					or txt:match("BẰNG%s*([A-Z]{1,2})")
					or txt:match("STARTING WITH%s*([A-Z]{1,2})")
					or txt:match("STARTS WITH%s*([A-Z]{1,2})")

				if m then
					found = m
					break
				end

				-- Text ngắn 1-2 chữ cái in hoa
				if #txt >= 1 and #txt <= 2 and txt:match("^[A-Z]+$") then
					local absPos = obj.AbsolutePosition
					if absPos.Y > 30 and absPos.Y < 500 then
						found = txt
						break
					end
				end
			end
		end

		if found ~= "" and found ~= lastPrefix then
			lastPrefix = found
			inputBox.Text = found
			updateUI(found)
		end

		task.wait(0.7)
	end
end)

inputBox:GetPropertyChangedSignal("Text"):Connect(function()
	updateUI(inputBox.Text)
end)

