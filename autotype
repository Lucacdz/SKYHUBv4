-- ===== ESP 2D =====
local ESP2D = {}

local function GetOrCreateESP2D(p)
    if ESP2D[p] then return ESP2D[p] end
    local box = New("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false}, ESPContainer)
    local boxStroke = New("UIStroke", {Thickness = 2, Color = Color3.new(1,1,1)}, box)
    local healthBg = New("Frame", {BackgroundColor3 = Color3.fromRGB(40,40,40), BorderSizePixel = 0, Visible = false}, ESPContainer)
    local healthFill = New("Frame", {Size = UDim2.new(1,0,1,0), BackgroundColor3 = Color3.fromRGB(0,255,0), BorderSizePixel = 0}, healthBg)
    local tracer = New("Frame", {BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Visible = false, AnchorPoint = Vector2.new(0,0.5)}, ESPContainer)
    ESP2D[p] = {Box = box, BoxStroke = boxStroke, HealthBg = healthBg, HealthFill = healthFill, Tracer = tracer}
    return ESP2D[p]
end

local function ClearESP2D(p)
    local obj = ESP2D[p]
    if obj then
        pcall(function() obj.Box:Destroy() end)
        pcall(function() obj.HealthBg:Destroy() end)
        pcall(function() obj.Tracer:Destroy() end)
        ESP2D[p] = nil
    end
end

local function UpdateESP2D()
    Camera = workspace.CurrentCamera
    if not Camera or not S.ESP then
        for p, _ in pairs(ESP2D) do ClearESP2D(p) end
        return
    end

    local vp = Camera.ViewportSize
    local topCenter = Vector2.new(vp.X / 2, 0)

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char or not IsAlive(char) or (S.ESPTeam and IsTeammate(p)) then
            ClearESP2D(p)
            continue
        end

        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not head or not root or not hum then
            ClearESP2D(p)
            continue
        end

        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local origin = myRoot and myRoot.Position or Camera.CFrame.Position
        local dist = (origin - root.Position).Magnitude
        if dist > S.ESPDist then
            ClearESP2D(p)
            continue
        end

        local color = S.ESPColor
        if S.ESPTeamColor and p.Team then color = p.TeamColor.Color end

        local headVP, onHead = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local footVP, onFoot = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

        local obj = GetOrCreateESP2D(p)

        if onHead and onFoot and headVP.Z > 0 and footVP.Z > 0 then
            local height = math.abs(headVP.Y - footVP.Y)
            local width = height * 0.55
            local centerX = (headVP.X + footVP.X) / 2
            local topY = math.min(headVP.Y, footVP.Y)

            if S.ShowBox then
                obj.Box.Visible = true
                obj.Box.Position = UDim2.new(0, centerX - width/2, 0, topY)
                obj.Box.Size = UDim2.new(0, width, 0, height)
                obj.BoxStroke.Color = color
            else
                obj.Box.Visible = false
            end

            if S.ShowHealthBar then
                local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                local barWidth = 5
                local barX = centerX - width/2 - barWidth - 3
                obj.HealthBg.Visible = true
                obj.HealthBg.Position = UDim2.new(0, barX, 0, topY)
                obj.HealthBg.Size = UDim2.new(0, barWidth, 0, height)
                obj.HealthFill.Size = UDim2.new(1, 0, hpRatio, 0)
                obj.HealthFill.Position = UDim2.new(0, 0, 1 - hpRatio, 0)
                obj.HealthFill.BackgroundColor3 = Color3.fromHSV(hpRatio * 0.33, 1, 1)
            else
                obj.HealthBg.Visible = false
            end

            if S.ShowTracer then
                local head2d = Vector2.new(headVP.X, headVP.Y)
                local delta = head2d - topCenter
                local length = math.max(delta.Magnitude, 1)
                local mid = (topCenter + head2d) / 2
                local angle = math.deg(math.atan2(delta.Y, delta.X))
                obj.Tracer.Visible = true
                obj.Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
                obj.Tracer.Position = UDim2.new(0, mid.X, 0, mid.Y)
                obj.Tracer.Size = UDim2.new(0, length, 0, 2)
                obj.Tracer.Rotation = angle
                obj.Tracer.BackgroundColor3 = color
            else
                obj.Tracer.Visible = false
            end
        else
            obj.Box.Visible = false
            obj.HealthBg.Visible = false
            obj.Tracer.Visible = false
        end
    end

    for p, _ in pairs(ESP2D) do
        if not p.Parent or not Players:FindFirstChild(p.Name) then
            ClearESP2D(p)
        end
    end
end

