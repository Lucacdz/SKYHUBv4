    render()
    cb(state)

    return function(v)
        state = v
        render()
        cb(v)
    end
end

-- Thanh trượt
local function Slider(page, text, min, max, def, step, fmt, cb)
    local f = ItemFrame(page, 50)
    ItemLabel(f, text, 4)
    local val = New("TextLabel", {
        Size = UDim2.new(0.35, 0, 0, 22),
        Position = UDim2.new(0.65, -10, 0, 4),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = T.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, f)

    local track = New("Frame", {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.new(0, 10, 0, 34),
        BackgroundColor3 = T.Off,
        BorderSizePixel = 0,
    }, f)
    Round(track, 3)
    local fill = New("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0}, track)
    Round(fill, 3)
    local knob = New("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    Round(knob, 8)

    local function set(v)
        local a = (v - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        val.Text = fmt and fmt(v) or tostring(v)
        cb(v)
    end

    local function setFromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local v = min + a * (max - min)
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, min, max)
        set(v)
    end

    local hit = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = "",
    }, f)

    local dragging = false
    hit.InputBegan:Connect(function(input)
        if IsPress(input) then
            dragging = true
            SetScroll(false)
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and IsMove(input) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and IsPress(input) then
            dragging = false
            SetScroll(true)
        end
    end)

    set(def)
end

