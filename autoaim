local function TryParent(getParent)
    local ok, parent = pcall(getParent)
    if ok and parent then
        local ok2 = pcall(function() Gui.Parent = parent end)
        if ok2 and Gui.Parent == parent then
            return true
        end
    end
    return false
end

local parented = false
if gethui then parented = TryParent(function() return gethui() end) end
if not parented then parented = TryParent(function() return game:GetService("CoreGui") end) end
