-- RenderStepped = update nhanh hơn, khó giật hơn
RunService.RenderStepped:Connect(function(dt)
    if not char or not hum or not root then return end

    local moveDir = Vector3.zero
    local camCF = camera.CFrame

    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end

    if UIS.TouchEnabled and hum.MoveDirection.Magnitude > 0.1 then
        moveDir = hum.MoveDirection
    end

    if flying then
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDir -= Vector3.new(0, 1, 0)
        end

        if moveDir.Magnitude > 0 then
            local move = moveDir.Unit * flySpeed * dt * 60
            root.CFrame = root.CFrame + move
            root.AssemblyLinearVelocity = moveDir.Unit * flySpeed
        else
            root.AssemblyLinearVelocity = Vector3.zero
        end
        root.AssemblyAngularVelocity = Vector3.zero
    else
        if moveDir.Magnitude > 0 then
            local move = moveDir.Unit * speed * dt * 60
            root.CFrame = root.CFrame + move
            root.AssemblyLinearVelocity = moveDir.Unit * speed
        else
            root.AssemblyLinearVelocity = Vector3.zero
        end
        root.AssemblyAngularVelocity = Vector3.zero
        hum.WalkSpeed = 16
    end
end)

