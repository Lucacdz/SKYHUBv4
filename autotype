-- ===== LOGIC CHUNG =====
local function IsAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function IsTeammate(p)
    return LocalPlayer.Team ~= nil and p.Team == LocalPlayer.Team
end

-- ===== AIM =====
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function IsVisible(part)
    local origin = Camera.CFrame.Position
    local ignore = {}
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    if part.Parent then table.insert(ignore, part.Parent) end
    rayParams.FilterDescendantsInstances = ignore
    return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function GetTarget()
    local best, bestDist = nil, math.huge
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local camPos = Camera.CFrame.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and IsAlive(p.Character) then
            if not (S.AimTeam and IsTeammate(p)) then
                local part = p.Character:FindFirstChild(S.AimPart) or p.Character:FindFirstChild("Head")
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then
                        local d2 = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        local d3 = (part.Position - camPos).Magnitude
                        if d2 <= S.FOV and d3 <= S.AimDist and d2 < bestDist then
                            if not S.WallCheck or IsVisible(part) then
                                bestDist = d2
                                best = part
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local lastTarget = nil

_G.SkyHubProConn = RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    Circle.Visible = S.Aim and S.ShowCircle

    if not S.Aim then
        lastTarget = nil
        return
    end

    if S.AutoOff and lastTarget and lastTarget.Parent and not IsAlive(lastTarget.Parent) then
        lastTarget = nil
        AimSet(false)
        return
    end

    local target = GetTarget()
    lastTarget = target
    if target then
        local goal = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        local alpha = math.clamp(1 - S.Smooth / 100, 0.05, 1)
        Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
    end
end)

-- ===== ESP =====
local function ClearESP(char)
    if not char then return end
    local h = char:FindFirstChild("SkyESP")
    if h then h:Destroy() end
    local head = char:FindFirstChild("Head")
    if head then
        local t = head:FindFirstChild("SkyTag")
        if t then t:Destroy() end
    end
end

local function ApplyESP(p)
    local char = p.Character
    if not S.ESP or not char or not IsAlive(char) or (S.ESPTeam and IsTeammate(p)) then
        ClearESP(char)
        return
    end

    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not root or not hum then return end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local origin = myRoot and myRoot.Position or Camera.CFrame.Position
    local d = (origin - root.Position).Magnitude
    if d > S.ESPDist then
        ClearESP(char)
        return
    end

    local color = S.ESPColor
    if S.ESPTeamColor and p.Team then color = p.TeamColor.Color end

    -- Highlight
    local hl = char:FindFirstChild("SkyESP")
    if S.Chams then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "SkyESP"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.OutlineTransparency = 0
            hl.Parent = char
        end
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = S.ChamsFill
    elseif hl then
        hl:Destroy()
    end

    -- Tag tên / khoảng cách / máu
    local tag = head:FindFirstChild("SkyTag")
    if S.ShowName or S.ShowDist or S.ShowHP then
        local lines = {}
        if S.ShowName then table.insert(lines, p.Name) end
        local info = {}
        if S.ShowDist then table.insert(info, math.floor(d) .. "m") end
        if S.ShowHP then table.insert(info, "HP " .. math.floor(hum.Health)) end
        if #info > 0 then table.insert(lines, table.concat(info, " | ")) end

        if not tag then
            tag = New("BillboardGui", {
                Name = "SkyTag",
                StudsOffset = Vector3.new(0, 2.8, 0),
                AlwaysOnTop = true,
                Adornee = head,
            })
            New("TextLabel", {
                Name = "Lbl",
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextStrokeTransparency = 0,
            }, tag)
            tag.Parent = head
        end
        tag.Size = UDim2.new(0, 190, 0, math.max(#lines, 1) * (S.TextSize + 4))
        local lbl = tag:FindFirstChild("Lbl")
        if lbl then
            lbl.Text = table.concat(lines, "\n")
            lbl.TextSize = S.TextSize
            lbl.TextColor3 = color
        end
    elseif tag then
        tag:Destroy()
    end
end

