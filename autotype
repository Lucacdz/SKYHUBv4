-- Lựa chọn nhiều nút
local function Choice(page, text, options, defIdx, cb)
    local f = ItemFrame(page, 62)
    ItemLabel(f, text, 4)
    local buttons = {}
    local n = #options
    local function render(idx)
        for i, b in ipairs(buttons) do
            b.BackgroundColor3 = (i == idx) and T.Accent or T.Off
        end
    end
    for i, opt in ipairs(options) do
        local b = New("TextButton", {
            Size = UDim2.new(1 / n, -8, 0, 26),
            Position = UDim2.new((i - 1) / n, 6, 0, 30),
            BackgroundColor3 = T.Off,
            BorderSizePixel = 0,
            Text = opt,
            TextColor3 = T.Text,
            Font = Enum.Font.Gotham,
            TextSize = 13,
            AutoButtonColor = false,
        }, f)
        Round(b, 6)
        buttons[i] = b
        b.MouseButton1Click:Connect(function()
            render(i)
            cb(i, opt)
        end)
    end
    render(defIdx)
    cb(defIdx, options[defIdx])
end

