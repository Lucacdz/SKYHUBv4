-- ===== TELEPORT (nâng cao) =====
local TPState = {
    originalCFrame = nil,
    running = false,
    lastChar = nil,
}

local function GetTPTarget()
    local best, bestScore = nil, math.huge
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos = myRoot.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and IsAlive(p.Character) then
            if not (S.TPTeam and IsTeammate(p)) then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (root.Position - myPos).Magnitude
                    if dist <= S.TPMaxDist then
                        local score
                        if S.TPMode == 2 then
                            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                            if not onScreen or pos.Z <= 0 then continue end
                            score = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        else
                            score = dist
                        end
                        if score < bestScore then
                            bestScore = score
                            best = root
                        end
                    end
                end
            end
        end
    end
    return best
end

local function StopTeleport()
    TPState.running = false
    if TPState.originalCFrame then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function() root.CFrame = TPState.originalCFrame end)
        end
    end
    TPState.originalCFrame = nil
end

local function GetBehindCFrame(targetRoot, offset)
    local targetLook = targetRoot.CFrame.LookVector
    local behindPos = targetRoot.Position - targetLook * (offset or 3) + Vector3.new(0, 1, 0)
    return CFrame.new(behindPos, targetRoot.Position)
end

local function OrbitAround(targetRoot, radius, speedDeg, loops)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetPos = targetRoot.Position
    local startAngle = math.atan2(root.Position.Z - targetPos.Z, root.Position.X - targetPos.X)
    local totalAngle = math.rad(360 * math.max(1, math.floor(loops or 1)))
    local speedRad = math.rad(speedDeg or 180)
    local elapsed = 0

    while elapsed < totalAngle do
        if not S.Teleport then return end
        if not targetRoot or not targetRoot.Parent then return end
        if not LocalPlayer.Character or LocalPlayer.Character ~= char then return end

        local dt = task.wait() or 0.016
        elapsed = elapsed + speedRad * dt
        local angle = startAngle + elapsed

        local offsetX = math.cos(angle) * radius
        local offsetZ = math.sin(angle) * radius
        local newPos = targetPos + Vector3.new(offsetX, 1, offsetZ)

        pcall(function()
            root.CFrame = CFrame.new(newPos, targetRoot.Position)
        end)
    end
end

task.spawn(function()
    while Gui.Parent do
        task.wait(0.1)
        if not S.Teleport then
            if TPState.running then StopTeleport() end
            TPState.lastChar = nil
            continue
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root or hum.Health <= 0 then
            if TPState.running then StopTeleport() end
            TPState.lastChar = nil
            continue
        end

        if TPState.lastChar ~= char then
            TPState.lastChar = char
            TPState.originalCFrame = nil
            TPState.running = false
        end

        local target = GetTPTarget()
        if not target then
            if TPState.running then StopTeleport() end
            continue
        end

        if not TPState.originalCFrame then
            TPState.originalCFrame = root.CFrame
        end

        TPState.running = true

        local mode = S.TPModeExtra or 0

        if mode == 2 then
            pcall(function()
                OrbitAround(target, S.TPOrbitRadius, S.TPOrbitSpeed, S.TPOrbitLoops)
            end)
            task.wait(S.TPBackDelay / 1000)
            if TPState.originalCFrame then
                pcall(function() root.CFrame = TPState.originalCFrame end)
            end
        elseif mode == 1 then
            local behindCF = GetBehindCFrame(target, S.TPBehindOffset)
            pcall(function() root.CFrame = behindCF end)
            task.wait(S.TPBackDelay / 1000)
            if TPState.originalCFrame then
                pcall(function() root.CFrame = TPState.originalCFrame end)
            end
        else
            local targetPos = target.Position
            local offset = (root.Position - targetPos).Unit * 3
            if offset.Magnitude < 0.1 then offset = Vector3.new(0, 0, 3) end
            local tpPos = targetPos + offset + Vector3.new(0, 1, 0)
            pcall(function() root.CFrame = CFrame.new(tpPos, targetPos) end)
            task.wait(S.TPBackDelay / 1000)
            if TPState.originalCFrame then
                pcall(function() root.CFrame = TPState.originalCFrame end)
            end
        end

        task.wait(S.TPDelay / 1000)
    end
end)

-- ===== AUTO FIRE =====
local AutoFireBusy = false
local lastFireTime = 0

local function TryFireTool(tool)
    if not tool then return end
    pcall(function()
        if tool:IsA("Tool") then
            local re = tool:FindFirstChildOfClass("RemoteEvent")
            if re then re:FireServer() end
            local rf = tool:FindFirstChildOfClass("RemoteFunction")
            if rf then rf:InvokeServer() end
            local act = tool:FindFirstChild("Activated")
            if act then act:Fire() end
        end
    end)
end

task.spawn(function()
    while Gui.Parent do
        task.wait(0.03)
        if not S.AutoFire then
            AutoFireBusy = false
            continue
        end
        local now = tick()
        if now - lastFireTime < (S.AutoFireDelay or 100) / 1000 then
            continue
        end
        local char = LocalPlayer.Character
        if not char then continue end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end
        if lastTarget and lastTarget.Parent and IsAlive(lastTarget.Parent) then
            lastFireTime = now
            TryFireTool(tool)
        end
    end
end)

