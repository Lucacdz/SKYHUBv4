-- ===== LOGIC =====
local function GetCenter()
    return Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
end

local function IsInFOV(part)
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return false end
    return (Vector2.new(pos.X, pos.Y) - GetCenter()).Magnitude <= FOVRadius
end

local function GetTarget()
    local nearest, shortest = nil, math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p \~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 and IsInFOV(head) then
                local dist = (myRoot.Position - head.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = head
                end
            end
        end
    end
    return nearest
end

RunService.RenderStepped:Connect(function()
    local center = GetCenter()
    FOVCircle.Position = center
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = AimEnabled
    FOVCircle.Color = CircleColor

    if AimEnabled then
        local target = GetTarget()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            if AutoOffOnDeath then
                local hum = target.Parent:FindFirstChild("Humanoid")
                if hum and hum.Health <= 0 then
                    AimEnabled = false
                    aimToggle.Text = "AIM: TẮT"
                    aimToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                    FOVCircle.Visible = false
                end
            end
        end
    end

    -- ESP
    if not ESPEnabled then
        for _, obj in pairs(ESPObjects) do
            pcall(function()
                obj.Tracer:Remove()
                obj.Box:Remove()
                obj.Text:Remove()
            end)
        end
        ESPObjects = {}
        return
    end

    local seen = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player \~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local head = char.Head
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                seen[player] = true
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    if not ESPObjects[player] then
                        ESPObjects[player] = {
                            Tracer = Drawing.new("Line"),
                            Box = Drawing.new("Square"),
                            Text = Drawing.new("Text")
                        }
                        local o = ESPObjects[player]
                        o.Tracer.Thickness = 1.5
                        o.Box.Thickness = 1.5
                        o.Box.Filled = false
                        o.Text.Size = 13
                        o.Text.Center = true
                        o.Text.Outline = true
                    end
                    local o = ESPObjects[player]
                    o.Tracer.Visible = ShowTracer
                    o.Box.Visible = ShowBox
                    o.Text.Visible = ShowDistance

                    if ShowTracer then
                        o.Tracer.From = Vector2.new(center.X, 0)
                        o.Tracer.To = Vector2.new(pos.X, pos.Y)
                        o.Tracer.Color = TracerColor
                    end
                    if ShowBox then
                        local sz = (Camera:WorldToViewportPoint(root.Position) - Camera:WorldToViewportPoint(head.Position)).Magnitude * 2
                        o.Box.Size = Vector2.new(sz * 0.65, sz)
                        o.Box.Position = Vector2.new(pos.X - sz*0.32, pos.Y - sz*0.45)
                        o.Box.Color = ESPColor
                    end
                    if ShowDistance then
                        local d = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude) or 0
                        o.Text.Text = player.Name .. " [" .. d .. "]"
                        o.Text.Position = Vector2.new(pos.X, pos.Y - 28)
                        o.Text.Color = ESPColor
                    end
                else
                    if ESPObjects[player] then
                        ESPObjects[player].Tracer.Visible = false
                        ESPObjects[player].Box.Visible = false
                        ESPObjects[player].Text.Visible = false
                    end
                end
            end
        end
    end

    for plr, _ in pairs(ESPObjects) do
        if not seen[plr] then
            pcall(function()
                ESPObjects[plr].Tracer:Remove()
                ESPObjects[plr].Box:Remove()
                ESPObjects[plr].Text:Remove()
            end)
            ESPObjects[plr] = nil
        end
    end
end)

