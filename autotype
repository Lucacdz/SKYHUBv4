-- ===== LƯU / TẢI CẤU HÌNH =====
local CONFIG_FILE = "SkyHubPro.json"
local CanSave = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
local lastSaved = ""

local function EncodeConfig()
    local data = {}
    for k, v in pairs(S) do
        local t = typeof(v)
        if t == "boolean" or t == "number" or t == "string" then
            data[k] = v
        end
    end
    data.Aim = false; data.AimFull = false; data.Spin = false; data.Noclip = false
    data.FakeLag = false; data.ToolSpin = false; data.Aura = false; data.Swim = false
    data.ThirdPerson = false; data.FOVEnabled = false
    data.Teleport = false; data.AutoFire = false
    return HttpService:JSONEncode(data)
end

local function SaveConfig()
    if not CanSave then return false, "Executor không hỗ trợ lưu file" end
    local ok = pcall(function()
        local json = EncodeConfig()
        writefile(CONFIG_FILE, json)
        lastSaved = json
    end)
    return ok, ok and "Đã lưu cấu hình" or "Lỗi khi lưu cấu hình"
end

local function LoadConfig()
    if not CanSave then return false end
    local ok = pcall(function()
        if not isfile(CONFIG_FILE) then error("no file") end
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        for k, v in pairs(data) do
            if S[k] ~= nil and typeof(S[k]) == typeof(v) then
                S[k] = v
            end
        end
    end)
    if ok then
        S.CircleIdx = math.clamp(math.floor(S.CircleIdx), 1, #PaletteColors)
        S.ESPIdx = math.clamp(math.floor(S.ESPIdx), 1, #PaletteColors)
        S.AimPartIdx = math.clamp(math.floor(S.AimPartIdx), 1, 2)
        S.AimMode = math.clamp(math.floor(S.AimMode), 1, 4)
        S.AuraType = math.clamp(math.floor(S.AuraType or 1), 1, 6)
        S.TPMode = math.clamp(math.floor(S.TPMode or 1), 1, 2)
        S.TPModeExtra = math.clamp(math.floor(S.TPModeExtra or 0), 0, 2)
        S.CircleColor = PaletteColors[S.CircleIdx]
        S.ESPColor = PaletteColors[S.ESPIdx]
        S.AimPart = (S.AimPartIdx == 1) and "Head" or "HumanoidRootPart"
        S.Aim = false; S.AimFull = false; S.Spin = false; S.Noclip = false
        S.FakeLag = false; S.ToolSpin = false; S.Aura = false; S.Swim = false
        S.ThirdPerson = false; S.FOVEnabled = false
        S.Teleport = false; S.AutoFire = false
    end
    return ok
end

local ConfigLoaded = LoadConfig()

-- ===== HÀM TIỆN ÍCH GUI =====
local function New(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function Round(o, r)
    New("UICorner", {CornerRadius = UDim.new(0, r)}, o)
end

local function IsPress(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function IsMove(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
end

