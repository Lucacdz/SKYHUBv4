-- ===== LOGIC CHUNG =====
local function IsAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function IsTeammate(p)
    return LocalPlayer.Team ~= nil and p.Team == LocalPlayer.Team
end

-- ===== AIM =====
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function IsVisible(part)
    local origin = Camera.CFrame.Position
    local ignore = {}
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    if part.Parent then table.insert(ignore, part.Parent) end
    rayParams.FilterDescendantsInstances = ignore
    return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function GetTarget()
    local best, bestDist = nil, math.huge
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local camPos = Camera.CFrame.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and IsAlive(p.Character) then
            if not (S.AimTeam and IsTeammate(p)) then
                local part = p.Character:FindFirstChild(S.AimPart) or p.Character:FindFirstChild("Head")
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then
                        local d2 = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        local d3 = (part.Position - camPos).Magnitude
                        if d2 <= S.FOV and d3 <= S.AimDist then
                            local score
                            if S.AimMode == 2 then
                                score = d3                -- gần nhất (theo khoảng cách thật)
                            elseif S.AimMode == 3 then
                                score = -d3               -- xa nhất
                            elseif S.AimMode == 4 then
                                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                                score = (hum and hum.Health or 100) + d2 / 10000 -- ít máu nhất
                            else
                                score = d2                -- gần tâm màn hình
                            end
                            if score < bestDist and (not S.WallCheck or IsVisible(part)) then
                                bestDist = score
                                best = part
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local lastTarget = nil

_G.SkyHubProConn = RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    -- Camera FOV
    if S.CamFOVOn then
        Camera.FieldOfView = S.CamFOV
    end

    Circle.Visible = (S.Aim or S.AutoFire) and S.ShowCircle

    if not S.Aim then
        lastTarget = nil
        return
    end

    if S.AutoOff and lastTarget and lastTarget.Parent and not IsAlive(lastTarget.Parent) then
        lastTarget = nil
        AimSet(false)
        return
    end

    local target = GetTarget()
    lastTarget = target
    if target then
        local goal = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        local alpha = math.clamp(1 - S.Smooth / 100, 0.05, 1)
        Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
    end
end)

-- Giả lập chuột phải
local function SetRMB(down)
    local ok = pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        -- button 1 = right mouse
        VIM:SendMouseButtonEvent(0, 0, 1, down, game, 0)
    end)
    if not ok then
        pcall(function()
            if down then
                if mouse2press then mouse2press() end
            else
                if mouse2release then mouse2release() end
            end
        end)
    end
end

-- Auto Fire (giả lập đè chuột phải khi có mục tiêu)
local lastFire = 0
local autoHolding = false
task.spawn(function()
    while Gui.Parent do
        if S.AutoFire then
            local target = GetTarget()
            if target then
                if not autoHolding then
                    SetRMB(true)
                    autoHolding = true
                end
                -- vẫn gọi Activate thêm cho game hỗ trợ
                local now = tick()
                if now - lastFire >= (S.FireDelay / 1000) then
                    local char = LocalPlayer.Character
                    local tool = char and char:FindFirstChildOfClass("Tool")
                    if tool then
                        pcall(function() tool:Activate() end)
                    end
                    lastFire = now
                end
            else
                if autoHolding then
                    SetRMB(false)
                    autoHolding = false
                end
            end
        else
            if autoHolding then
                SetRMB(false)
                autoHolding = false
            end
        end
        task.wait(0.05)
    end
    if autoHolding then
        SetRMB(false)
    end
end)

