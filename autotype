local MoveState = {WS = nil, JP = nil}
local Conns = _G.SkyHubProConns

local function GetHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function RestoreMovement()
    local hum = GetHum()
    if hum then
        if MoveState.WS then hum.WalkSpeed = MoveState.WS end
        if MoveState.JP then
            if MoveState.JP.UseJumpPower then
                hum.JumpPower = MoveState.JP.Power
            else
                hum.JumpHeight = MoveState.JP.Height
            end
        end
    end
    MoveState.WS = nil
    MoveState.JP = nil
end

table.insert(Conns, UserInputService.JumpRequest:Connect(function()
    if S.InfJump then
        local hum = GetHum()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

table.insert(Conns, RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if S.SpeedOn then
        if MoveState.WS == nil then MoveState.WS = hum.WalkSpeed end
        hum.WalkSpeed = S.Speed
    elseif MoveState.WS ~= nil then
        hum.WalkSpeed = MoveState.WS
        MoveState.WS = nil
    end

    if S.JumpOn then
        if MoveState.JP == nil then
            MoveState.JP = {UseJumpPower = hum.UseJumpPower, Power = hum.JumpPower, Height = hum.JumpHeight}
        end
        if hum.UseJumpPower then
            hum.JumpPower = S.JumpPower
        else
            hum.JumpHeight = (S.JumpPower * S.JumpPower) / (2 * workspace.Gravity)
        end
    elseif MoveState.JP ~= nil then
        if MoveState.JP.UseJumpPower then
            hum.JumpPower = MoveState.JP.Power
        else
            hum.JumpHeight = MoveState.JP.Height
        end
        MoveState.JP = nil
    end

    if S.Spin then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.SpinSpeed * dt), 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end

    if S.Swim then
        hum:ChangeState(Enum.HumanoidStateType.Swimming)
    end

    if S.ToolSpin then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:FindFirstChild("Handle") then
            local handle = tool.Handle
            handle.CFrame = handle.CFrame * CFrame.Angles(0, math.rad(S.ToolSpinSpeed * dt), 0)
        end
    end
end))

