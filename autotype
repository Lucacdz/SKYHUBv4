-- Aura
local AuraObjects = {}

local function ClearAura()
    for _, obj in ipairs(AuraObjects) do
        pcall(function() obj:Destroy() end)
    end
    AuraObjects = {}
end

local function CreateAura(root)
    ClearAura()
    local typ = S.AuraType

    if typ == 1 then
        local e = Instance.new("ParticleEmitter")
        e.Name = "SkyAura"
        e.Rate = 50
        e.Lifetime = NumberRange.new(0.5, 1.4)
        e.Speed = NumberRange.new(1, 8)
        e.Size = NumberSequence.new(1.5, 0)
        e.Transparency = NumberSequence.new(0.2, 1)
        e.Color = ColorSequence.new(T.Accent)
        e.SpreadAngle = Vector2.new(180, 180)
        e.Parent = root
        table.insert(AuraObjects, e)
    elseif typ == 2 then
        local ring = Instance.new("Part")
        ring.Name = "SkyAuraRing"
        ring.Size = Vector3.new(8, 0.2, 8)
        ring.Shape = Enum.PartType.Cylinder
        ring.Material = Enum.Material.Neon
        ring.Color = T.Accent
        ring.Transparency = 0.4
        ring.CanCollide = false
        ring.Anchored = true
        ring.Massless = true
        ring.CFrame = root.CFrame * CFrame.new(0, -2.5, 0) * CFrame.Angles(0, 0, math.rad(90))
        ring.Parent = root
        table.insert(AuraObjects, ring)
    elseif typ == 3 then
        local hl = Instance.new("Highlight")
        hl.Name = "SkyAuraGlow"
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0
        hl.FillColor = T.Accent
        hl.OutlineColor = T.Accent
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = root.Parent
        table.insert(AuraObjects, hl)
    elseif typ == 4 then
        local fire = Instance.new("Fire")
        fire.Name = "SkyAuraFire"
        fire.Size = 6
        fire.Heat = 8
        fire.Color = T.Accent
        fire.SecondaryColor = Color3.fromRGB(255, 180, 0)
        fire.Parent = root
        table.insert(AuraObjects, fire)
    elseif typ == 5 then
        local spark = Instance.new("Sparkles")
        spark.Name = "SkyAuraSpark"
        spark.SparkleColor = T.Accent
        spark.Parent = root
        table.insert(AuraObjects, spark)
    elseif typ == 6 then
        local e = Instance.new("ParticleEmitter")
        e.Name = "SkyAuraRainbow"
        e.Rate = 60
        e.Lifetime = NumberRange.new(0.4, 1)
        e.Speed = NumberRange.new(3, 10)
        e.Size = NumberSequence.new(1.8, 0)
        e.Transparency = NumberSequence.new(0.1, 1)
        e.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 165, 0)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 100, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 255)),
        })
        e.SpreadAngle = Vector2.new(180, 180)
        e.Parent = root
        table.insert(AuraObjects, e)
    end
end

local function UpdateAura()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if S.Aura and root then
        local needRecreate = #AuraObjects == 0
        if not needRecreate then
            for _, obj in ipairs(AuraObjects) do
                if not obj or not obj.Parent then
                    needRecreate = true
                    break
                end
            end
        end
        if needRecreate then
            CreateAura(root)
        else
            if S.AuraType == 2 and AuraObjects[1] and AuraObjects[1]:IsA("BasePart") then
                AuraObjects[1].CFrame = root.CFrame * CFrame.new(0, -2.5, 0) * CFrame.Angles(0, 0, math.rad(90))
            end
        end
    else
        ClearAura()
    end
end

task.spawn(function()
    while Gui.Parent do
        pcall(UpdateAura)
        task.wait(0.3)
    end
    ClearAura()
end)

