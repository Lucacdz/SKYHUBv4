local function ItemFrame(p, h) local f = New("Frame", {Size = UDim2.new(1,0,0,h), BackgroundColor3 = T.Item, LayoutOrder = Next()}, p) Round(f, 8) return f end

local function Toggle(page, text, def, cb)
    local f = ItemFrame(page, 36)
    New("TextLabel", {Size = UDim2.new(1,-70,1,0), Position = UDim2.new(0,10,0,0), BackgroundTransparency = 1, Text = text, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, f)
    local sw = New("Frame", {Size = UDim2.new(0,40,0,20), Position = UDim2.new(1,-50,0.5,-10), BackgroundColor3 = T.Off}, f) Round(sw, 10)
    local knob = New("Frame", {Size = UDim2.new(0,16,0,16), BackgroundColor3 = Color3.new(1,1,1)}, sw) Round(knob, 8)
    local state = def
    local function render() sw.BackgroundColor3 = state and T.Accent or T.Off knob.Position = state and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8) end
    local hit = New("TextButton", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = ""}, f)
    hit.MouseButton1Click:Connect(function() state = not state render() cb(state) end)
    render() cb(state)
    return function(v) state = v render() cb(v) end
end

local function Slider(page, text, min, max, def, step, fmt, cb)
    local f = ItemFrame(page, 50)
    New("TextLabel", {Size = UDim2.new(0.65,0,0,22), Position = UDim2.new(0,10,0,4), BackgroundTransparency = 1, Text = text, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, f)
    local val = New("TextLabel", {Size = UDim2.new(0.35,0,0,22), Position = UDim2.new(0.65,-10,0,4), BackgroundTransparency = 1, TextColor3 = T.Accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right}, f)
    local track = New("Frame", {Size = UDim2.new(1,-20,0,6), Position = UDim2.new(0,10,0,34), BackgroundColor3 = T.Off}, f) Round(track, 3)
    local fill = New("Frame", {BackgroundColor3 = T.Accent}, track) Round(fill, 3)
    local knob = New("Frame", {Size = UDim2.new(0,16,0,16), AnchorPoint = Vector2.new(0.5,0.5), BackgroundColor3 = Color3.new(1,1,1)}, track) Round(knob, 8)
    local function set(v) local a = (v-min)/(max-min) fill.Size = UDim2.new(a,0,1,0) knob.Position = UDim2.new(a,0,0.5,0) val.Text = fmt and fmt(v) or tostring(v) cb(v) end
    local function setFromX(x) local a = math.clamp((x - track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1) local v = min + a*(max-min) v = math.floor(v/step+0.5)*step set(math.clamp(v,min,max)) end
    local hit = New("TextButton", {Size = UDim2.new(1,0,0,30), Position = UDim2.new(0,0,0,20), BackgroundTransparency = 1, Text = ""}, f)
    local dragging = false
    hit.InputBegan:Connect(function(i) if IsPress(i) then dragging = true setFromX(i.Position.X) end end)
    UserInputService.InputChanged:Connect(function(i) if dragging and IsMove(i) then setFromX(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if IsPress(i) then dragging = false end end)
    set(def)
end

local function Palette(page, text, defIdx, cb)
    local f = ItemFrame(page, 62)
    New("TextLabel", {Size = UDim2.new(1,0,0,22), Position = UDim2.new(0,10,0,4), BackgroundTransparency = 1, Text = text, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, f)
    local strokes = {}
    local function render(idx) for i,st in ipairs(strokes) do st.Enabled = (i==idx) end end
    for i,c in ipairs(PaletteColors) do
        local b = New("TextButton", {Size = UDim2.new(0,28,0,22), Position = UDim2.new(0,10+(i-1)*36,0,32), BackgroundColor3 = c, Text = "", AutoButtonColor = false}, f)
        Round(b, 6)
        strokes[i] = New("UIStroke", {Thickness = 2, Color = Color3.new(1,1,1), Enabled = false}, b)
        b.MouseButton1Click:Connect(function() render(i) cb(c, i) end)
    end
    render(defIdx) cb(PaletteColors[defIdx], defIdx)
end

local function Choice(page, text, options, defIdx, cb)
    local f = ItemFrame(page, 62)
    New("TextLabel", {Size = UDim2.new(1,0,0,22), Position = UDim2.new(0,10,0,4), BackgroundTransparency = 1, Text = text, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, f)
    local buttons, n = {}, #options
    local function render(idx) for i,b in ipairs(buttons) do b.BackgroundColor3 = (i==idx) and T.Accent or T.Off end end
    for i,opt in ipairs(options) do
        local b = New("TextButton", {Size = UDim2.new(1/n,-8,0,26), Position = UDim2.new((i-1)/n,6,0,30), BackgroundColor3 = T.Off, Text = opt, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13, AutoButtonColor = false}, f)
        Round(b, 6) buttons[i] = b
        b.MouseButton1Click:Connect(function() render(i) cb(i, opt) end)
    end
    render(defIdx) cb(defIdx, options[defIdx])
end

local function Button(page, text, color, cb)
    local b = New("TextButton", {Size = UDim2.new(1,0,0,36), BackgroundColor3 = color or T.Accent, Text = text, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 13, LayoutOrder = Next()}, page)
    Round(b, 8) b.MouseButton1Click:Connect(function() cb(b) end) return b
end

