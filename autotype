local AuraObjs = {}
local Conns = _G.SkyHubProConns
local lagTick = 0

local function ClearAuras()
    for _, o in pairs(AuraObjs) do pcall(function() o:Destroy() end) end
    AuraObjs = {}
end

table.insert(Conns, RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local root = char:FindFirstChild("HumanoidRootPart")

    if S.Swim then hum:ChangeState(Enum.HumanoidStateType.Swimming) end
    if S.FakeLag and root then
        lagTick = lagTick + 1
        if lagTick >= S.LagStrength then lagTick = 0 root.CFrame = root.CFrame * CFrame.new(0,0,-0.12) end
    end
    if S.ItemSpin then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:FindFirstChild("Handle") then
            tool.Handle.CFrame = tool.Handle.CFrame * CFrame.Angles(0, math.rad(S.ItemSpinSpeed * dt), 0)
        end
    end

    -- AURAS
    if S.AuraHighlight then
        if not AuraObjs.HL or AuraObjs.HL.Parent \~= char then
            if AuraObjs.HL then AuraObjs.HL:Destroy() end
            AuraObjs.HL = Instance.new("Highlight")
            AuraObjs.HL.Name = "AuraHL"
            AuraObjs.HL.FillTransparency = 0.65
            AuraObjs.HL.OutlineTransparency = 0
            AuraObjs.HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            AuraObjs.HL.Parent = char
        end
        AuraObjs.HL.FillColor = S.AuraColor
        AuraObjs.HL.OutlineColor = S.AuraColor
    elseif AuraObjs.HL then AuraObjs.HL:Destroy() AuraObjs.HL = nil end

    if S.AuraParticle and root then
        if not AuraObjs.Part then
            local p = Instance.new("ParticleEmitter")
            p.Name = "AuraPart"
            p.Rate = 40
            p.Lifetime = NumberRange.new(0.6, 1.2)
            p.Speed = NumberRange.new(2, 5)
            p.SpreadAngle = Vector2.new(180, 180)
            p.Size = NumberSequence.new(0.4)
            p.Parent = root
            AuraObjs.Part = p
        end
        AuraObjs.Part.Color = ColorSequence.new(S.AuraColor)
    elseif AuraObjs.Part then AuraObjs.Part:Destroy() AuraObjs.Part = nil end

    if S.AuraOrbit and root then
        if not AuraObjs.Orbit then
            local part = Instance.new("Part")
            part.Name = "AuraOrbit"
            part.Size = Vector3.new(0.6, 0.6, 0.6)
            part.Shape = Enum.PartType.Ball
            part.Anchored = true
            part.CanCollide = false
            part.Material = Enum.Material.Neon
            part.Parent = workspace
            AuraObjs.Orbit = part
            AuraObjs.OrbitAngle = 0
        end
        AuraObjs.Orbit.Color = S.AuraColor
        AuraObjs.OrbitAngle = (AuraObjs.OrbitAngle or 0) + dt * 3
        local ang = AuraObjs.OrbitAngle
        AuraObjs.Orbit.CFrame = root.CFrame * CFrame.new(math.cos(ang)*3, 1.5, math.sin(ang)*3)
    elseif AuraObjs.Orbit then AuraObjs.Orbit:Destroy() AuraObjs.Orbit = nil end

    if S.AuraTrail and root then
        if not AuraObjs.Trail then
            local a0 = Instance.new("Attachment", root)
            local a1 = Instance.new("Attachment", root)
            a1.Position = Vector3.new(0, 2, 0)
            local tr = Instance.new("Trail")
            tr.Attachment0 = a0
            tr.Attachment1 = a1
            tr.Lifetime = 0.4
            tr.MinLength = 0.1
            tr.Parent = root
            AuraObjs.Trail = tr
            AuraObjs.TrailA0 = a0
            AuraObjs.TrailA1 = a1
        end
        AuraObjs.Trail.Color = ColorSequence.new(S.AuraColor)
    elseif AuraObjs.Trail then
        AuraObjs.Trail:Destroy()
        if AuraObjs.TrailA0 then AuraObjs.TrailA0:Destroy() end
        if AuraObjs.TrailA1 then AuraObjs.TrailA1:Destroy() end
        AuraObjs.Trail = nil
    end

    if S.AuraLight and root then
        if not AuraObjs.Light then
            local l = Instance.new("PointLight")
            l.Name = "AuraLight"
            l.Range = 12
            l.Brightness = 2
            l.Parent = root
            AuraObjs.Light = l
        end
        AuraObjs.Light.Color = S.AuraColor
    elseif AuraObjs.Light then AuraObjs.Light:Destroy() AuraObjs.Light = nil end
end))

