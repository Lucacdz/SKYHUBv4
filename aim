-- ===== LOGIC =====
local function GetCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function IsInFOV(head)
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    return (Vector2.new(pos.X, pos.Y) - GetCenter()).Magnitude <= FOVRadius
end

local function GetTarget()
    if SelectedPlayer then
        local char = SelectedPlayer.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChild("Humanoid")
        if head and hum and hum.Health > 0 and IsInFOV(head) then
            return head
        end
        return nil
    end
    local nearest, shortest = nil, math.huge
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p \~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 and IsInFOV(head) then
                local d = (root.Position - head.Position).Magnitude
                if d < shortest then shortest, nearest = d, head end
            end
        end
    end
    return nearest
end

local function ClearESP()
    for _, obj in pairs(ESPObjects) do
        pcall(function()
            if obj.Tracer then obj.Tracer:Remove() end
            if obj.Box then obj.Box:Remove() end
            if obj.Text then obj.Text:Remove() end
        end)
    end
    ESPObjects = {}
end

RunService.RenderStepped:Connect(function()
    local center = GetCenter()
    FOVCircle.Position = center
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = AimEnabled
    FOVCircle.Color = CircleColor

    if AimEnabled then
        local target = GetTarget()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            if AutoOffOnDeath then
                local hum = target.Parent:FindFirstChild("Humanoid")
                if hum and hum.Health <= 0 then
                    AimEnabled = false
                    ToggleAim.Text = "AIM: TẮT"
                    ToggleAim.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                    FOVCircle.Visible = false
                end
            end
        end
    end

    if not ESPEnabled then
        ClearESP()
        return
    end

    local seen = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player \~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local head = char.Head
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                seen[player] = true
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    if not ESPObjects[player] then
                        ESPObjects[player] = {
                            Tracer = Drawing.new("Line"),
                            Box = Drawing.new("Square"),
                            Text = Drawing.new("Text")
                        }
                        ESPObjects[player].Tracer.Thickness = 1.5
                        ESPObjects[player].Box.Thickness = 1.5
                        ESPObjects[player].Box.Filled = false
                        ESPObjects[player].Text.Size = 14
                        ESPObjects[player].Text.Center = true
                        ESPObjects[player].Text.Outline = true
                    end

                    local obj = ESPObjects[player]
                    obj.Tracer.Visible = ShowTracer
                    obj.Box.Visible = ShowBox
                    obj.Text.Visible = ShowDistance

                    if ShowTracer then
                        obj.Tracer.From = Vector2.new(center.X, 0)
                        obj.Tracer.To = Vector2.new(pos.X, pos.Y)
                        obj.Tracer.Color = TracerColor
                    end

                    if ShowBox then
                        local size = (Camera:WorldToViewportPoint(root.Position) - Camera:WorldToViewportPoint(head.Position)).Magnitude * 2.2
                        obj.Box.Size = Vector2.new(size * 0.7, size)
                        obj.Box.Position = Vector2.new(pos.X - size * 0.35, pos.Y - size * 0.5)
                        obj.Box.Color = ESPColor
                    end

                    if ShowDistance then
                        local dist = 0
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
                        end
                        obj.Text.Text = player.Name .. " [" .. dist .. "m]"
                        obj.Text.Position = Vector2.new(pos.X, pos.Y - 30)
                        obj.Text.Color = ESPColor
                    end
                else
                    if ESPObjects[player] then
                        ESPObjects[player].Tracer.Visible = false
                        ESPObjects[player].Box.Visible = false
                        ESPObjects[player].Text.Visible = false
                    end
                end
            end
        end
    end

    for player, _ in pairs(ESPObjects) do
        if not seen[player] then
            local obj = ESPObjects[player]
            pcall(function()
                if obj.Tracer then obj.Tracer:Remove() end
                if obj.Box then obj.Box:Remove() end
                if obj.Text then obj.Text:Remove() end
            end)
            ESPObjects[player] = nil
        end
    end
end)

