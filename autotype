-- ========== LOGIC ==========
local isVisible = true
local currentWords = {nil, nil}

local function getTwoWords(prefix)
	prefix = string.upper(prefix)
	local matches = {}

	for _, word in ipairs(wordList) do
		if string.sub(string.upper(word), 1, #prefix) == prefix then
			table.insert(matches, word)
		end
	end

	if #matches == 0 then
		return nil, nil
	end

	-- Xáo trộn
	for i = #matches, 2, -1 do
		local j = math.random(1, i)
		matches[i], matches[j] = matches[j], matches[i]
	end

	local w1 = matches[1]
	local w2 = matches[2] or matches[1]

	return w1, w2
end

-- Tìm TextBox đang được focus trong game (để tự điền)
local function getFocusedTextBox()
	local focused = UserInputService:GetFocusedTextBox()
	if focused and focused:IsA("TextBox") and focused ~= inputBox then
		return focused
	end
	return nil
end

-- Hàm tự điền từ vào ô nhập + TextBox game (nếu có)
local function autoFill(word)
	if not word or word == "" then return end

	-- Điền vào helper
	inputBox.Text = word

	-- Điền vào TextBox đang focus trong game (nếu có)
	local gameBox = getFocusedTextBox()
	if gameBox then
		gameBox.Text = word
		-- Có thể thêm :CaptureFocus() nếu muốn giữ focus
	end
end

local function updateSuggestions()
	local text = string.upper(inputBox.Text)
	-- Chỉ lấy tối đa 2 chữ cái
	text = string.sub(text, 1, 2)
	inputBox.Text = text -- tự động cắt còn 2 chữ

	if text == "" then
		wordBtn1.Text = "Gõ 1-2 chữ cái"
		wordBtn2.Text = ""
		currentWords = {nil, nil}
		return
	end

	local w1, w2 = getTwoWords(text)
	currentWords = {w1, w2}

	if w1 then
		wordBtn1.Text = w1
		wordBtn2.Text = w2 or ""
	else
		wordBtn1.Text = "Không tìm thấy từ"
		wordBtn2.Text = ""
		currentWords = {nil, nil}
	end
end

-- Kết nối sự kiện
inputBox:GetPropertyChangedSignal("Text"):Connect(updateSuggestions)

wordBtn1.MouseButton1Click:Connect(function()
	if currentWords[1] then
		autoFill(currentWords[1])
